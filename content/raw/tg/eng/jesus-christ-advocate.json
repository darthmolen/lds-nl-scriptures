    "body": "<header>\n<h1 data-aid=\"128477070\" id=\"title1\"><strong>Jesus Christ, Advocate</strong></h1>\n</header>\n<div class=\"body-block\">\n<nav class=\"index\">\n<ul class=\"reference\">\n<li>\n<p class=\"title\" data-aid=\"128477072\" id=\"title2\"><em>See also</em> <a class=\"scripture-ref\" href=\"/study/scriptures/tg/jesus-christ-mediator?lang=eng\">Jesus Christ, Mediator</a></p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477074\" id=\"p1\">he ever liveth to make <span class=\"key-word\">intercession</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/heb/7?lang=eng&amp;id=p25#p25\">Heb. 7:25</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477076\" id=\"p2\">to appear in the presence of God <span class=\"key-word\">for us</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/heb/9?lang=eng&amp;id=p24#p24\">Heb. 9:24</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477078\" id=\"p3\"><span class=\"key-word\">advocate</span> with the Father, <span class=\"key-word\">Jesus</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/1-jn/2?lang=eng&amp;id=p1#p1\">1 Jn. 2:1</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477080\" id=\"p4\">he shall make <span class=\"key-word\">intercession</span> for all, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/2?lang=eng&amp;id=p9#p9\">2 Ne. 2:9</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477082\" id=\"p5\">giving the Son power to make <span class=\"key-word\">intercession</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/mosiah/15?lang=eng&amp;id=p8#p8\">Mosiah 15:8</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477084\" id=\"p6\">he <span class=\"key-word\">advocateth</span> the cause of the children of men, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/moro/7?lang=eng&amp;id=p28#p28\">Moro. 7:28</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477086\" id=\"p7\">I am … your <span class=\"key-word\">advocate</span> with the Father, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/29?lang=eng&amp;id=p5#p5\">D&amp;C 29:5</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/32?lang=eng&amp;id=p3#p3\">32:3</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/45?lang=eng&amp;id=p3#p3\">45:3</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/62?lang=eng&amp;id=p1#p1\">62:1</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/110?lang=eng&amp;id=p4#p4\">110:4</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477088\" id=\"p8\">have I <span class=\"key-word\">pleaded</span> before the Father for them, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/38?lang=eng&amp;id=p4#p4\">D&amp;C 38:4</a>.</p>\n</li>\n</ul>\n</nav>\n</div>",
