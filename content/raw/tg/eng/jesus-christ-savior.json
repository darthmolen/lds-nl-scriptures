    "body": "<header>\n<h1 data-aid=\"128478200\" id=\"title1\"><strong>Jesus Christ, Savior</strong></h1>\n</header>\n<div class=\"body-block\">\n<nav class=\"index\">\n<ul class=\"reference\">\n<li>\n<p class=\"title\" data-aid=\"128478201\" id=\"title2\"><em>See also</em> <a class=\"scripture-ref\" href=\"/study/scriptures/tg/jesus-christ-atonement-through?lang=eng\">Jesus Christ, Atonement through</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/tg/jesus-christ-redeemer?lang=eng\">Jesus Christ, Redeemer</a></p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128478202\" id=\"p1\">Lord is … my <span class=\"key-word\">salvation</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ex/15?lang=eng&amp;id=p2#p2\">Ex. 15:2</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478203\" id=\"p2\">my fortress, and my <span class=\"key-word\">deliverer</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/2-sam/22?lang=eng&amp;id=p2#p2\">2 Sam. 22:2</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478204\" id=\"p3\">Lord is my light and my <span class=\"key-word\">salvation</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/27?lang=eng&amp;id=p1#p1\">Ps. 27:1</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478205\" id=\"p4\">thou art my help and my <span class=\"key-word\">deliverer</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/40?lang=eng&amp;id=p17#p17\">Ps. 40:17</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/70?lang=eng&amp;id=p5#p5\">70:5</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478206\" id=\"p5\">They forgat God their <span class=\"key-word\">saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/106?lang=eng&amp;id=p21#p21\">Ps. 106:21</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478207\" id=\"p6\">my <span class=\"key-word\">deliverer</span>; my shield, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/144?lang=eng&amp;id=p2#p2\">Ps. 144:2</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478208\" id=\"p7\">he shall send them a <span class=\"key-word\">saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/19?lang=eng&amp;id=p20#p20\">Isa. 19:20</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478209\" id=\"p8\">I am … the Holy One of Israel, thy <span class=\"key-word\">Saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/43?lang=eng&amp;id=p3#p3\">Isa. 43:3</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478210\" id=\"p9\">beside me there is no <span class=\"key-word\">saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/43?lang=eng&amp;id=p11#p11\">Isa. 43:11</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/76?lang=eng&amp;id=p1#p1\">D&amp;C 76:1</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478211\" id=\"p10\">God of Israel, the <span class=\"key-word\">Saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/45?lang=eng&amp;id=p15#p15\">Isa. 45:15</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478212\" id=\"p11\">whosoever shall call on the … Lord shall be <span class=\"key-word\">delivered</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/joel/2?lang=eng&amp;id=p32#p32\">Joel 2:32</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128478213\" id=\"p12\">he shall <span class=\"key-word\">save</span> his people from their sins, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/matt/1?lang=eng&amp;id=p21#p21\">Matt. 1:21</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478214\" id=\"p13\">my spirit hath rejoiced in God my <span class=\"key-word\">Saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/luke/1?lang=eng&amp;id=p47#p47\">Luke 1:47</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478215\" id=\"p14\">born … in the city of David a <span class=\"key-word\">Saviour</span>, which is Christ, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/luke/2?lang=eng&amp;id=p11#p11\">Luke 2:11</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478216\" id=\"p15\">world through him might be <span class=\"key-word\">saved</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/3?lang=eng&amp;id=p17#p17\">John 3:17</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478217\" id=\"p16\">this is indeed the Christ, the <span class=\"key-word\">Saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/4?lang=eng&amp;id=p42#p42\">John 4:42</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478218\" id=\"p17\">whosoever shall call on the … Lord shall be <span class=\"key-word\">saved</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/2?lang=eng&amp;id=p21#p21\">Acts 2:21</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478219\" id=\"p18\">none other name … whereby we must be <span class=\"key-word\">saved</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/4?lang=eng&amp;id=p12#p12\">Acts 4:12</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/25?lang=eng&amp;id=p20#p20\">2 Ne. 25:20</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/mosiah/3?lang=eng&amp;id=p17#p17\">Mosiah 3:17</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/mosiah/5?lang=eng&amp;id=p8#p8\">5:8</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/18?lang=eng&amp;id=p23#p23\">D&amp;C 18:23</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/pgp/moses/6?lang=eng&amp;id=p52#p52\">Moses 6:52</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478220\" id=\"p19\">Him hath God exalted … to be a Prince and a <span class=\"key-word\">Saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/5?lang=eng&amp;id=p31#p31\">Acts 5:31</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478221\" id=\"p20\">did God send to be a ruler and a <span class=\"key-word\">deliverer</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/7?lang=eng&amp;id=p35#p35\">Acts 7:35</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478222\" id=\"p21\">raised unto Israel a <span class=\"key-word\">Saviour</span>, Jesus, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/13?lang=eng&amp;id=p23#p23\">Acts 13:23</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478223\" id=\"p22\">shouldest be for <span class=\"key-word\">salvation</span> unto the ends of the earth, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/13?lang=eng&amp;id=p47#p47\">Acts 13:47</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478224\" id=\"p23\">shall come out of Sion the <span class=\"key-word\">Deliverer</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/rom/11?lang=eng&amp;id=p26#p26\">Rom. 11:26</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478225\" id=\"p24\">we look for the <span class=\"key-word\">Saviour</span>, the Lord Jesus Christ, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/philip/3?lang=eng&amp;id=p20#p20\">Philip. 3:20</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478226\" id=\"p25\">we trust in the living God, who is the <span class=\"key-word\">Saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/1-tim/4?lang=eng&amp;id=p10#p10\">1 Tim. 4:10</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478227\" id=\"p26\">glorious appearing of … our <span class=\"key-word\">Saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/titus/2?lang=eng&amp;id=p13#p13\">Titus 2:13</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478228\" id=\"p27\">he is the <span class=\"key-word\">propitiation</span> for our sins, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/1-jn/2?lang=eng&amp;id=p2#p2\">1 Jn. 2:2</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478229\" id=\"p28\">sent the Son to be the <span class=\"key-word\">Saviour</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/1-jn/4?lang=eng&amp;id=p14#p14\">1 Jn. 4:14</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128478230\" id=\"p29\">Lamb of God is the Son … the <span class=\"key-word\">Savior</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/1-ne/13?lang=eng&amp;id=p40#p40\">1 Ne. 13:40</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478231\" id=\"p30\">I, the Lord, am thy <span class=\"key-word\">Savior</span> and thy Redeemer, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/1-ne/21?lang=eng&amp;id=p26#p26\">1 Ne. 21:26</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/bofm/1-ne/22?lang=eng&amp;id=p12#p12\">22:12</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478232\" id=\"p31\">Mighty God shall <span class=\"key-word\">deliver</span> his covenant people, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/6?lang=eng&amp;id=p17#p17\">2 Ne. 6:17</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478233\" id=\"p32\">following your Lord and your <span class=\"key-word\">Savior</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/31?lang=eng&amp;id=p13#p13\">2 Ne. 31:13</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478234\" id=\"p33\">knowledge of a <span class=\"key-word\">Savior</span> shall spread, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/mosiah/3?lang=eng&amp;id=p20#p20\">Mosiah 3:20</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478235\" id=\"p34\">must die that <span class=\"key-word\">salvation</span> may come, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/hel/14?lang=eng&amp;id=p15#p15\">Hel. 14:15</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478236\" id=\"p35\">forbidden them by our Lord and <span class=\"key-word\">Savior</span> Jesus Christ, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/morm/3?lang=eng&amp;id=p14#p14\">Morm. 3:14</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128478237\" id=\"p36\">knowledge of a <span class=\"key-word\">Savior</span> come unto my people, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/3?lang=eng&amp;id=p16#p16\">D&amp;C 3:16</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478238\" id=\"p37\">I am Jesus Christ, the <span class=\"key-word\">Savior</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/43?lang=eng&amp;id=p34#p34\">D&amp;C 43:34</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128478239\" id=\"p38\">mine Only Begotten is and shall be the <span class=\"key-word\">Savior</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/pgp/moses/1?lang=eng&amp;id=p6#p6\">Moses 1:6</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128478240\" id=\"p39\">as many as believed in the Son … should be <span class=\"key-word\">saved</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/pgp/moses/5?lang=eng&amp;id=p15#p15\">Moses 5:15</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul class=\"reference\">\n<li>\n<p class=\"title\" data-aid=\"128478241\" id=\"title3\"><em>See also</em> <a class=\"scripture-ref\" href=\"/study/scriptures/ot/hab/3?lang=eng&amp;id=p13#p13\">Hab. 3:13</a>.</p>\n</li>\n</ul>\n</nav>\n</div>",
