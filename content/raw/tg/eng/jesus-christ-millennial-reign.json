    "body": "<header>\n<h1 data-aid=\"128477555\" id=\"title1\"><strong>Jesus Christ, Millennial Reign</strong></h1>\n</header>\n<div class=\"body-block\">\n<nav class=\"index\">\n<ul class=\"reference\">\n<li>\n<p class=\"title\" data-aid=\"128477557\" id=\"title2\"><em>See also</em> <a class=\"scripture-ref\" href=\"/study/scriptures/tg/jesus-christ-king?lang=eng\">Jesus Christ, King</a></p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477558\" id=\"p1\">establish for ever, and build up thy <span class=\"key-word\">throne</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/89?lang=eng&amp;id=p4#p4\">Ps. 89:4</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477560\" id=\"p2\">Holy One of Israel is our <span class=\"key-word\">king</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/89?lang=eng&amp;id=p18#p18\">Ps. 89:18</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477562\" id=\"p3\">David … Of the fruit of thy body will I set upon thy <span class=\"key-word\">throne</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/ps/132?lang=eng&amp;id=p11#p11\">Ps. 132:11</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477564\" id=\"p4\"><span class=\"key-word\">government</span> shall be upon his shoulder, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/9?lang=eng&amp;id=p6#p6\">Isa. 9:6</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/19?lang=eng&amp;id=p6#p6\">2 Ne. 19:6</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477565\" id=\"p5\">he shall not <span class=\"key-word\">judge</span> after the sight of his eyes, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/11?lang=eng&amp;id=p3#p3\">Isa. 11:3</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/21?lang=eng&amp;id=p3#p3\">2 Ne. 21:3</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477567\" id=\"p6\">in mercy shall the <span class=\"key-word\">throne</span> be established … of David, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/16?lang=eng&amp;id=p5#p5\">Isa. 16:5</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477569\" id=\"p7\">king shall <span class=\"key-word\">reign</span> in righteousness, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/32?lang=eng&amp;id=p1#p1\">Isa. 32:1</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477571\" id=\"p8\">Lord is our <span class=\"key-word\">king</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/33?lang=eng&amp;id=p22#p22\">Isa. 33:22</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477572\" id=\"p9\">King shall <span class=\"key-word\">reign</span> and prosper, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/jer/23?lang=eng&amp;id=p5#p5\">Jer. 23:5</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477574\" id=\"p10\">shall the God of heaven set up a <span class=\"key-word\">kingdom</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/dan/2?lang=eng&amp;id=p44#p44\">Dan. 2:44</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477576\" id=\"p11\">his dominion is an <span class=\"key-word\">everlasting</span> dominion, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/dan/7?lang=eng&amp;id=p14#p14\">Dan. 7:14</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477577\" id=\"p12\">king of Israel … is in the <span class=\"key-word\">midst</span> of thee, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/zeph/3?lang=eng&amp;id=p15#p15\">Zeph. 3:15</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/1?lang=eng&amp;id=p36#p36\">D&amp;C 1:36</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477579\" id=\"p13\">Lord shall be <span class=\"key-word\">king</span> over all the earth, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/zech/14?lang=eng&amp;id=p9#p9\">Zech. 14:9</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477581\" id=\"p14\">God shall give unto him the <span class=\"key-word\">throne</span> of his father David, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/luke/1?lang=eng&amp;id=p32#p32\">Luke 1:32</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477583\" id=\"p15\">he must <span class=\"key-word\">reign</span>, till he hath put all enemies under his feet, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/1-cor/15?lang=eng&amp;id=p25#p25\">1 Cor. 15:25</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/58?lang=eng&amp;id=p22#p22\">D&amp;C 58:22</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477584\" id=\"p16\">he shall <span class=\"key-word\">reign</span> for ever and ever, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/rev/11?lang=eng&amp;id=p15#p15\">Rev. 11:15</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477586\" id=\"p17\"><span class=\"key-word\">reigned</span> with Christ a thousand years, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/rev/20?lang=eng&amp;id=p4#p4\">Rev. 20:4</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/29?lang=eng&amp;id=p11#p11\">D&amp;C 29:11</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/76?lang=eng&amp;id=p63#p63\">76:63</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477588\" id=\"p18\">when the <span class=\"key-word\">thousand</span> years are expired, Satan shall be loosed, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/rev/20?lang=eng&amp;id=p7#p7\">Rev. 20:7</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/43?lang=eng&amp;id=p29#p29\">D&amp;C 43:29</a>).</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477590\" id=\"p19\">because of the <span class=\"key-word\">righteousness</span> … Satan has no power, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/1-ne/22?lang=eng&amp;id=p26#p26\">1 Ne. 22:26</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477591\" id=\"p20\"><span class=\"key-word\">Lord</span> of the vineyard saw that his fruit was good, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/jacob/5?lang=eng&amp;id=p75#p75\">Jacob 5:75</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477593\" id=\"p21\">Lord … shall <span class=\"key-word\">reign</span> in their midst, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/1?lang=eng&amp;id=p36#p36\">D&amp;C 1:36</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477595\" id=\"p22\">I will … dwell in righteousness … a <span class=\"key-word\">thousand</span> years, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/29?lang=eng&amp;id=p11#p11\">D&amp;C 29:11</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477597\" id=\"p23\">my people shall … <span class=\"key-word\">reign</span> with me on earth, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/43?lang=eng&amp;id=p29#p29\">D&amp;C 43:29</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477598\" id=\"p24\">he <span class=\"key-word\">reigns</span> whose right it is to <span class=\"key-word\">reign</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/58?lang=eng&amp;id=p22#p22\">D&amp;C 58:22</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477599\" id=\"p25\">come … to <span class=\"key-word\">reign</span> on the earth over his people, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/76?lang=eng&amp;id=p63#p63\">D&amp;C 76:63</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477600\" id=\"p26\">sit on the throne … to <span class=\"key-word\">reign</span> forever and ever, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/76?lang=eng&amp;id=p108#p108\">D&amp;C 76:108</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477601\" id=\"p27\">Christ will <span class=\"key-word\">reign</span> personally upon the earth, <a class=\"scripture-ref\" href=\"/study/scriptures/pgp/a-of-f/1?lang=eng&amp;id=p10#p10\">A of F 1:10</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul class=\"reference\">\n<li>\n<p class=\"title\" data-aid=\"128477602\" id=\"title3\"><em>See also</em> <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/40?lang=eng&amp;id=p11#p11\">Isa. 40:11</a>.</p>\n</li>\n</ul>\n</nav>\n</div>",
