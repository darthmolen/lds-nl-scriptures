    "body": "<header>\n<h1 data-aid=\"128477550\" id=\"title1\"><strong>Jesus Christ, Messiah</strong></h1>\n</header>\n<div class=\"body-block\">\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477551\" id=\"p1\">Lord hath <span class=\"key-word\">anointed</span> me to preach, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/61?lang=eng&amp;id=p1#p1\">Isa. 61:1</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/nt/luke/4?lang=eng&amp;id=p18#p18\">Luke 4:18</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/4?lang=eng&amp;id=p27#p27\">Acts 4:27</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477552\" id=\"p2\">shall <span class=\"key-word\">Messiah</span> be cut off, but not for himself, <a class=\"scripture-ref\" href=\"/study/scriptures/ot/dan/9?lang=eng&amp;id=p26#p26\">Dan. 9:26</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477553\" id=\"p3\">Thou art the <span class=\"key-word\">Christ</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/matt/16?lang=eng&amp;id=p16#p16\">Matt. 16:16</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/nt/mark/8?lang=eng&amp;id=p29#p29\">Mark 8:29</a>).</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477554\" id=\"p4\">tell no man that he was Jesus the <span class=\"key-word\">Christ</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/matt/16?lang=eng&amp;id=p20#p20\">Matt. 16:20</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477556\" id=\"p5\">Art thou the <span class=\"key-word\">Christ</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/mark/14?lang=eng&amp;id=p61#p61\">Mark 14:61</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477559\" id=\"p6\">devils … saying, Thou art <span class=\"key-word\">Christ</span> the Son of God, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/luke/4?lang=eng&amp;id=p41#p41\">Luke 4:41</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477561\" id=\"p7\"><span class=\"key-word\">Messias</span>, which is, being interpreted, the Christ, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/1?lang=eng&amp;id=p41#p41\">John 1:41</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477563\" id=\"p8\">I know that <span class=\"key-word\">Messias</span> cometh, which is called Christ, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/4?lang=eng&amp;id=p25#p25\">John 4:25</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477566\" id=\"p9\">this is indeed the <span class=\"key-word\">Christ</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/4?lang=eng&amp;id=p42#p42\">John 4:42</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477568\" id=\"p10\">believe that Jesus is the <span class=\"key-word\">Christ</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/20?lang=eng&amp;id=p31#p31\">John 20:31</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477570\" id=\"p11\">thy holy child Jesus, whom thou hast <span class=\"key-word\">anointed</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/4?lang=eng&amp;id=p27#p27\">Acts 4:27</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477573\" id=\"p12\">How God <span class=\"key-word\">anointed</span> Jesus of Nazareth, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/10?lang=eng&amp;id=p38#p38\">Acts 10:38</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477575\" id=\"p13\">Paul … testified to the Jews that Jesus was <span class=\"key-word\">Christ</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/18?lang=eng&amp;id=p5#p5\">Acts 18:5</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477578\" id=\"p14\">every tongue should confess that Jesus Christ is <span class=\"key-word\">Lord</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/nt/philip/2?lang=eng&amp;id=p11#p11\">Philip. 2:11</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477580\" id=\"p15\">God raise up among the Jews—even a <span class=\"key-word\">Messiah</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/1-ne/10?lang=eng&amp;id=p4#p4\">1 Ne. 10:4</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477582\" id=\"p16\"><span class=\"key-word\">Messiah</span> shall be manifested in body, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/1-ne/15?lang=eng&amp;id=p13#p13\">1 Ne. 15:13</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477585\" id=\"p17\">Holy One of Israel, the true <span class=\"key-word\">Messiah</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/1?lang=eng&amp;id=p10#p10\">2 Ne. 1:10</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477587\" id=\"p18\">redemption cometh in and through the Holy <span class=\"key-word\">Messiah</span>, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/2?lang=eng&amp;id=p6#p6\">2 Ne. 2:6</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477589\" id=\"p19\"><span class=\"key-word\">Messiah</span> cometh in the fulness of time, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/2?lang=eng&amp;id=p26#p26\">2 Ne. 2:26</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477592\" id=\"p20\"><span class=\"key-word\">Messiah</span> hath risen from the dead, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/25?lang=eng&amp;id=p14#p14\">2 Ne. 25:14</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477594\" id=\"p21\"><span class=\"key-word\">Messiah</span> is … rejected of the Jews, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/25?lang=eng&amp;id=p18#p18\">2 Ne. 25:18</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477596\" id=\"p22\">he shall be called Jesus <span class=\"key-word\">Christ</span>, the Son of God, <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/mosiah/3?lang=eng&amp;id=p8#p8\">Mosiah 3:8</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477975\" id=\"p23\">I am Alpha and Omega, <span class=\"key-word\">Christ</span> the Lord, <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/19?lang=eng&amp;id=p1#p1\">D&amp;C 19:1</a> (<a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/38?lang=eng&amp;id=p1#p1\">38:1</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/45?lang=eng&amp;id=p7#p7\">45:7</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/75?lang=eng&amp;id=p1#p1\">75:1</a>).</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul>\n<li>\n<p class=\"entry\" data-aid=\"128477976\" id=\"p24\">Jesus <span class=\"key-word\">Christ</span>, the only name which shall be given, <a class=\"scripture-ref\" href=\"/study/scriptures/pgp/moses/6?lang=eng&amp;id=p52#p52\">Moses 6:52</a>.</p>\n</li>\n<li>\n<p class=\"entry\" data-aid=\"128477977\" id=\"p25\">Lord said … I am <span class=\"key-word\">Messiah</span>, the King of Zion, <a class=\"scripture-ref\" href=\"/study/scriptures/pgp/moses/7?lang=eng&amp;id=p53#p53\">Moses 7:53</a>.</p>\n</li>\n</ul>\n</nav>\n<nav class=\"index\">\n<ul class=\"reference\">\n<li>\n<p class=\"title\" data-aid=\"128477978\" id=\"title2\"><em>See also</em> <a class=\"scripture-ref\" href=\"/study/scriptures/ot/gen/49?lang=eng&amp;id=p10#p10\">Gen. 49:10</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/10?lang=eng&amp;id=p27#p27\">Isa. 10:27</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/ot/isa/11?lang=eng&amp;id=p1#p1\">11:1</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/nt/john/1?lang=eng&amp;id=p49#p49\">John 1:49</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/3?lang=eng&amp;id=p15#p15\">Acts 3:15</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/nt/acts/5?lang=eng&amp;id=p31#p31\">5:31</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/nt/heb/2?lang=eng&amp;id=p10#p10\">Heb. 2:10</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/nt/heb/12?lang=eng&amp;id=p2#p2\">12:2</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/bofm/2-ne/20?lang=eng&amp;id=p27#p27\">2 Ne. 20:27</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/dc-testament/dc/58?lang=eng&amp;id=p22#p22\">D&amp;C 58:22</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/pgp/moses/4?lang=eng&amp;id=p2#p2\">Moses 4:2</a>; <a class=\"scripture-ref\" href=\"/study/scriptures/pgp/abr/3?lang=eng&amp;id=p27#p27\">Abr. 3:27</a>.</p>\n</li>\n</ul>\n</nav>\n</div>",
